# Tamil Nadu PDS Portal Environment Configuration

# PostgreSQL Configuration
PG_USER=postgres
PG_HOST=localhost
PG_DATABASE=pds_db
PG_PASSWORD=your_postgres_password_here
PG_PORT=5432

# Redis Configuration (Memurai uses default port 6379)
REDIS_URL=redis://localhost:6379

# Fast2SMS API Configuration (from https://www.fast2sms.com/ -> Dev API)
FAST2SMS_API_KEY=your_fast2sms_api_key_here

# JWT Secret for Session Management
JWT_SECRET=tnpds_secure_jwt_token_secret_2026

# Server Port
PORT=3000
